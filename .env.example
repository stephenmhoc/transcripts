# Generate real secrets with: transcripts init
APP_ORIGIN=http://127.0.0.1:8765
DATA_DIR=data
OWNER_TOKEN=replace-with-random-owner-token
MCP_TOKEN=replace-with-random-read-only-mcp-token
WORKER_TOKEN=replace-with-random-worker-token
SESSION_SECRET=replace-with-random-session-signing-secret
DISCOVERY_ENABLED=true
PUBLIC_BASE_URL=
# Optional Cloudflare Access sign-in: a verified Access identity for ACCESS_EMAIL
# replaces the owner key in the browser. Set all three or none.
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
ACCESS_EMAIL=
# Worker-only settings; a remote mini should receive ONLY the worker token.
WORKER_URL=http://127.0.0.1:8765
WHISPER_MODEL=mlx-community/whisper-large-v3-turbo-q4
